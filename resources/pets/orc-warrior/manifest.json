    },
    "soundClipId": "orc-fight"
  },
  "galleryPresentation": {
    "scale": 1.3,
    "offsetY": -5
  },
  "actionMetadata": {
    "heroic-strike": {
      "name": "英勇打击",
      "durationMs": 2300,
      "retrigger": "restart",
      "soundClipId": "orc-fight",
      "featured": true
    }
  }
}
